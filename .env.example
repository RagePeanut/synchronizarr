# ─────────────────────────────────────────────────────────────────────────────
# You can enable EITHER or BOTH pipelines:
#   • Letterboxd → Radarr (movies)  — set LETTERBOXD_URL + RADARR_*
#   • Serializd  → Sonarr (TV shows) — set SERIALIZD_URL + SONARR_*
# At least one complete pipeline must be configured.
# ─────────────────────────────────────────────────────────────────────────────

# ── Letterboxd → Radarr (movies) ──
# Your Letterboxd url (your username is the part after letterboxd.com/user/)
LETTERBOXD_URL=https://letterboxd.com/yourusernamehere/watchlist/

# Radarr Configuration
# Base URL of your Radarr instance (include http/https and port)
RADARR_API_URL=http://localhost:7878
# API key from Radarr Settings > General > Security > API Key
RADARR_API_KEY=your_radarr_api_key_here
# Quality profile name (must match exactly - case sensitive)
RADARR_QUALITY_PROFILE=HD-1080p
# When movies become available for download (announced, inCinemas, released)
RADARR_MINIMUM_AVAILABILITY=released
# Add movies in unmonitored state (true to add as unmonitored, false to add as monitored)
# RADARR_ADD_UNMONITORED=false
# Additional tags to apply to movies (comma-separated). Movies are always tagged 'letterboxd'.
# RADARR_TAGS=watchlist

# ── Serializd → Sonarr (TV shows) ──
# Your Serializd list URL. Supported forms:
#   https://serializd.com/user/<username>/watchlist
#   https://serializd.com/user/<username>/lists/<list-slug>
#   https://serializd.com/list/<public-list-slug-or-id>
# SERIALIZD_URL=https://serializd.com/user/yourusernamehere/watchlist

# Sonarr Configuration
# Base URL of your Sonarr instance (include http/https and port)
# SONARR_API_URL=http://localhost:8989
# API key from Sonarr Settings > General > Security > API Key
# SONARR_API_KEY=your_sonarr_api_key_here
# Quality profile name (must match exactly - case sensitive)
# SONARR_QUALITY_PROFILE=HD-1080p
# Specific Sonarr root folder ID (uses first available if unset)
# SONARR_ROOT_FOLDER_ID=1
# Add series in unmonitored state (true to add as unmonitored, false to add as monitored)
# SONARR_ADD_UNMONITORED=false
# Additional tags to apply to series (comma-separated). Series are always tagged 'serializd'.
# SONARR_TAGS=serializd-watchlist
# Comma-separated season numbers to monitor for every added series (e.g. "1,2").
# When unset, all seasons are monitored. Serializd entries pinning specific seasons take precedence.
# SONARR_MONITOR_SEASONS=1

# ── Plex labels (optional, applies to BOTH pipelines) ──
# When PLEX_URL and PLEX_TOKEN are set, synced items are also labelled in Plex,
# mirroring the tags applied in Radarr/Sonarr. This lets you build Smart
# Collections in Plex driven by those labels — no manual tagging.
# Plex is only ever used to add/remove LABELS; it never adds or removes media.
# Leave PLEX_URL/PLEX_TOKEN unset to disable (nothing touches Plex).
# Base URL of your Plex server (include http/https and port)
# PLEX_URL=http://localhost:32400
# Plex auth token (see https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/)
# PLEX_TOKEN=your_plex_token_here
# Plex library names to label. When unset, movie/show libraries are auto-detected.
# Set these if you have multiple libraries of a given type.
# PLEX_MOVIE_LIBRARY=Movies
# PLEX_TV_LIBRARY=TV Shows
# Override the labels applied in Plex (comma-separated). When unset, Plex labels
# default to the same custom tags configured for Radarr/Sonarr (RADARR_TAGS /
# SONARR_TAGS). Note: unlike Radarr/Sonarr, the 'letterboxd' / 'serializd'
# default tag is NOT applied to Plex labels.
# PLEX_MOVIE_TAGS=watchlist
# PLEX_TV_TAGS=watchlist

# Application Configuration
# Directory for storing application data (persistent storage)
DATA_DIR=./data
# How often to check for new movies in minutes (minimum 10)
CHECK_INTERVAL_MINUTES=60
# Environment mode (development, production, test)
NODE_ENV=development
# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Movie Limiting (optional - both must be specified together)
# Number of movies to sync from watchlist
# LETTERBOXD_TAKE_AMOUNT=10
# Strategy for selecting movies (newest or oldest)
# LETTERBOXD_TAKE_STRATEGY=newest

# Dry run mode (true to simulate actions without making changes, false to perform actual operations)
# DRY_RUN=true

# ── Sync behavior (applies to BOTH the Radarr and Sonarr pipelines) ──
# 'add' (default): only add items. 'sync': also remove items no longer on the source list.
# SYNC_MODE=add
# Update tags on items that already exist in Radarr/Sonarr. Required for SYNC_MODE=sync.
# UPDATE_EXISTING_TAGS=false
# When removing items in sync mode, also delete the files from disk.
# DELETE_FILES=true
# When removing items in sync mode, add an import exclusion to prevent re-adding.
# ADD_IMPORT_EXCLUSION=false
# Comma-separated tag names that protect an item from removal in sync mode.
# EXCLUDE_TAGS=collection
